{% liquid
  assign effect = 'hdt-reveal="slide-in" timeline'
  if section.id contains 'slideshow'
    assign effect = 'reval'
  endif   
%}
<div {{ effect }} id="block-{{ block.id }}" class="hdt-text-warry hdt-rte {{ block.settings.text_color }}{% if block.settings.hidden_br_mobile %} hdt-br-hidden{% endif %}{% if block.settings.hidden_on_mobile %} hdt-hide-mobile{% endif %} hdt-{{ block.settings.heading_size }} {{ block.settings.line_height }} {{ block.settings.font_family }} hdt-font-{{ block.settings.font_weight }} hdt-heading-transform-{{ block.settings.text_transform }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</div>
{%- if block.settings.heading_size == "h_custom" -%}
  {%- style -%}
    #block-{{ block.id }} {
      --heading-fs-lg: {{ block.settings.font_size_heading_lg }}px;
      --heading-fs-mb: {{ block.settings.font_size_heading }}px;
      --heading-lh-lg: {% if block.settings.line_height_heading_lg == 0 %}normal{% else %}{{ block.settings.line_height_heading_lg }}px{% endif %};
      --heading-lh-mb: {% if block.settings.line_height_heading == 0 %}normal{% else %}{{ block.settings.line_height_heading }}px{% endif %};
      --heading-ls: {{ block.settings.letter_spacing_heading }}px;
      --heading-ls-mb: {{ block.settings.letter_spacing_heading_mobile }}px;
      font-size: var(--heading-fs-mb);
      line-height: var(--heading-lh-mb);
      letter-spacing: var(--heading-ls-mb);
    }
    #block-{{ block.id }} * {
      font-size: inherit;
      line-height: inherit;
      letter-spacing: inherit;
    }
    @media (min-width: 768px) {
      #block-{{ block.id }} {
        font-size: var(--heading-fs-lg);
        line-height: var(--heading-lh-lg);
        letter-spacing: var(--heading-ls);
      }
    }
  {%- endstyle -%}
{%- endif -%}
{%- style -%}
  {%- if block.settings.font_family == 'hdt-font-1' -%}
    #block-{{ block.id }}, #block-{{ block.id }} * { font-family: var(--f_family_1) !important; }
  {%- elsif block.settings.font_family == 'hdt-font-2' -%}
    #block-{{ block.id }}, #block-{{ block.id }} * { font-family: var(--f_family_2) !important; }
  {%- elsif block.settings.font_family == 'hdt-font-3' -%}
    #block-{{ block.id }}, #block-{{ block.id }} * { font-family: var(--f_family_3) !important; }
  {%- endif -%}
  #block-{{ block.id }} * { font-weight: inherit; text-transform: inherit; }
  #block-{{ block.id }}.hdt-heading-transform-uppercase { text-transform: uppercase; }
  #block-{{ block.id }}.hdt-heading-transform-lowercase { text-transform: lowercase; }
  #block-{{ block.id }}.hdt-heading-transform-capitalize { text-transform: capitalize; }
{%- endstyle -%}
{% schema %}
{
  "name": "t:blocks.heading.name",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:blocks.text.settings.content.label",
      "default": "<p>Heading</p>",
      "info": "t:blocks.text.settings.content.info"
    },
    {
      "type": "checkbox",
      "id": "hidden_br_mobile",
      "label": "t:blocks.text.settings.hidden_br_mobile",
      "default": false,
      "visible_if": "{{ block.settings.heading contains '<br/>' }}"
    },
    {
      "type": "checkbox",
      "id": "hidden_on_mobile",
      "label": "t:blocks.text.settings.hidden_on_mobile",
      "default": false,
      "visible_if": "{{ block.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "t:settings_schema.typography.settings.line_height.label",
      "options": [
        {
          "value": "",
          "label": "t:settings_schema.typography.settings.line_height.default"
        },
        {
          "value": "hdt-lh-1-2",
          "label": "t:settings_schema.typography.settings.line_height.hdt-lh-1-2"
        },
        {
          "value": "hdt-lh-1",
          "label": "t:settings_schema.typography.settings.line_height.hdt-lh-1"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "t:settings_schema.typography.settings.font_weight.label",
      "options": [
        {
          "value": "light",
          "label": "t:settings_schema.typography.settings.font_weight.light"
        },
        {
          "value": "normal",
          "label": "t:settings_schema.typography.settings.font_weight.normal"
        },
        {
          "value": "medium",
          "label": "t:settings_schema.typography.settings.font_weight.medium"
        },
        {
          "value": "semibold",
          "label": "t:settings_schema.typography.settings.font_weight.semibold"
        },
        {
          "value": "bold",
          "label": "t:settings_schema.typography.settings.font_weight.bold"
        },
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.heading contains '<p>' }}"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family",
      "options": [
        {
          "value": "",
          "label": "Inherit"
        },
        {
          "value": "hdt-font-1",
          "label": "Font 1"
        },
        {
          "value": "hdt-font-2",
          "label": "Font 2"
        },
        {
          "value": "hdt-font-3",
          "label": "Font 3"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:settings_schema.typography.settings.font_size.label",
      "options": [
        {
          "value": "base",
          "label": "t:settings_schema.heading.settings.base_size"
        },
        {
          "value": "h6",
          "label": "t:settings_schema.heading.settings.h6_size"
        },
        {
          "value": "h5",
          "label": "t:settings_schema.heading.settings.h5_size"
        },
        {
          "value": "h4",
          "label": "t:settings_schema.heading.settings.h4_size"
        },
        {
          "value": "h3",
          "label": "t:settings_schema.heading.settings.h3_size"
        },
        {
          "value": "h2",
          "label": "t:settings_schema.heading.settings.h2_size"
        },
        {
          "value": "h1",
          "label": "t:settings_schema.heading.settings.h1_size"
        },
        {
          "value": "h0",
          "label": "t:settings_schema.heading.settings.h0_size"
        },
        {
          "value": "h_custom",
          "label": "t:settings_schema.typography.settings.font_size.custom"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "text_color",
      "options": [
        {
          "value": "hdt-s-text",
          "label": "t:default"
        },
        {
          "value": "hdt-text-secondary",
          "label": "t:settings_schema.colors.secondary"
        },
        {
          "value": "hdt-text-tertiary",
          "label": "t:settings_schema.colors.tertiary"
        },
        {
          "value": "hdt-text-primary",
          "label": "t:settings_schema.colors.accent"
        }
      ],
      "label": "t:blocks.text.text_color.label",
      "default": "hdt-s-text"
    },
    {
      "type": "header",
      "content": "t:blocks.text.custom_size_options.label",
      "visible_if": "{{ block.settings.heading_size == 'h_custom' }}"
    },
    {
      "type": "range",
      "id": "font_size_heading_lg",
      "min": 10,
      "max": 160,
      "step": 1,
      "unit": "px",
      "label": "t:settings_schema.typography.settings.font_size.label",
      "default": 50,
      "visible_if": "{{ block.settings.heading_size == 'h_custom' }}"
    },
    {
      "type": "range",
      "id": "font_size_heading",
      "min": 10,
      "max": 120,
      "step": 1,
      "unit": "px",
      "label": "t:settings_schema.typography.settings.font_size.mobile_font_size",
      "default": 24,
      "visible_if": "{{ block.settings.heading_size == 'h_custom' }}"
    },
    {
      "type": "range",
      "id": "letter_spacing_heading",
      "min": -10,
      "max": 10,
      "step": 0.2,
      "unit": "px",
      "label": "t:settings_schema.typography.settings.letter_spacing",
      "default": 0,
      "visible_if": "{{ block.settings.heading_size == 'h_custom' }}"
    },
    {
      "type": "range",
      "id": "line_height_heading_lg",
      "min": 0,
      "max": 200,
      "step": 1,
      "unit": "px",
      "label": "Line height",
      "info": "Set to 0 to use the default line height.",
      "default": 0,
      "visible_if": "{{ block.settings.heading_size == 'h_custom' }}"
    },
    {
      "type": "range",
      "id": "line_height_heading",
      "min": 0,
      "max": 160,
      "step": 1,
      "unit": "px",
      "label": "Mobile line height",
      "info": "Set to 0 to use the default line height.",
      "default": 0,
      "visible_if": "{{ block.settings.heading_size == 'h_custom' }}"
    },
    {
      "type": "range",
      "id": "letter_spacing_heading_mobile",
      "min": -10,
      "max": 10,
      "step": 0.2,
      "unit": "px",
      "label": "Mobile letter spacing",
      "default": 0,
      "visible_if": "{{ block.settings.heading_size == 'h_custom' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.heading.name",
    }
  ]
}
{% endschema %}
