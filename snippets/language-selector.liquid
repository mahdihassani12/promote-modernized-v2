{%- comment -%}
  Direct EN/AR switch. Shopify resolves return_to to the equivalent translated
  URL, keeping customers on the same product, collection, page, or article.
{%- endcomment -%}
{%- assign active_language_code = request.locale.iso_code | split: '-' | first -%}
{%- assign target_language = nil -%}
{%- assign target_language_code = '' -%}

{%- for language in localization.available_languages -%}
  {%- assign language_code = language.iso_code | split: '-' | first -%}
  {%- if active_language_code == 'ar' and language_code == 'en' -%}
    {%- assign target_language = language -%}
    {%- assign target_language_code = 'en' -%}
    {%- break -%}
  {%- elsif active_language_code != 'ar' and language_code == 'ar' -%}
    {%- assign target_language = language -%}
    {%- assign target_language_code = 'ar' -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if target_language != nil -%}
  <nav class="language-switcher" aria-label="Language selector">
    {%- form 'localization', class: 'language-switcher__form' -%}
      <input type="hidden" name="return_to" value="{{ request.path }}">
      <button
        class="language-switcher__trigger"
        type="submit"
        name="locale_code"
        value="{{ target_language.iso_code }}"
        aria-label="{% if target_language_code == 'ar' %}Switch to Arabic{% else %}Switch to English{% endif %}"
      >
        <svg class="language-switcher__globe" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.4 2.5 3.7 5.5 3.7 9s-1.3 6.5-3.7 9c-2.4-2.5-3.7-5.5-3.7-9S9.6 5.5 12 3Z"></path></svg>
        <span class="language-switcher__current" lang="{{ target_language.iso_code }}"{% if target_language_code == 'ar' %} dir="rtl"{% else %} dir="ltr"{% endif %}>{% if target_language_code == 'ar' %}العربية{% else %}English{% endif %}</span>
      </button>
    {%- endform -%}
  </nav>
{%- endif -%}
