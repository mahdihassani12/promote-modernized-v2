{%- liquid
  assign label = value.name | default: value
  assign language = request.locale.iso_code | split: '-' | first
  assign color_key = label | downcase | strip | replace: '-', ' '
  if language == 'ar'
    case color_key
      when 'black'
        assign label = 'أسود'
      when 'white'
        assign label = 'أبيض'
      when 'blue'
        assign label = 'أزرق'
      when 'navy', 'navy blue'
        assign label = 'كحلي'
      when 'purple'
        assign label = 'أرجواني'
      when 'violet'
        assign label = 'بنفسجي'
      when 'lavender'
        assign label = 'لافندر'
      when 'beige'
        assign label = 'بيج'
      when 'brown'
        assign label = 'بني'
      when 'grey', 'gray'
        assign label = 'رمادي'
      when 'space grey', 'space gray'
        assign label = 'رمادي داكن'
      when 'silver'
        assign label = 'فضي'
      when 'gold'
        assign label = 'ذهبي'
      when 'rose gold'
        assign label = 'ذهبي وردي'
      when 'pink'
        assign label = 'وردي'
      when 'red'
        assign label = 'أحمر'
      when 'green'
        assign label = 'أخضر'
      when 'dark green'
        assign label = 'أخضر داكن'
      when 'light blue'
        assign label = 'أزرق فاتح'
      when 'sky blue'
        assign label = 'أزرق سماوي'
      when 'orange'
        assign label = 'برتقالي'
      when 'yellow'
        assign label = 'أصفر'
      when 'transparent', 'clear'
        assign label = 'شفاف'
      when 'cream'
        assign label = 'كريمي'
      when 'titanium'
        assign label = 'تيتانيوم'
      when 'black titanium'
        assign label = 'تيتانيوم أسود'
      when 'bronze titanium'
        assign label = 'تيتانيوم برونزي'
      when 'burgundy'
        assign label = 'عنابي'
      when 'graphite'
        assign label = 'جرافيت'
      when 'gun metal', 'gunmetal'
        assign label = 'رمادي معدني'
      when 'midnight green'
        assign label = 'أخضر داكن'
      when 'pine'
        assign label = 'أخضر صنوبرى'
    endcase
  endif
  echo label | escape
-%}
