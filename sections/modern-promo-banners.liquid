{{ 'modern-sections.css' | asset_url | stylesheet_tag }}
<section class="modern-section" style="--modern-py:{{ section.settings.padding }}px;--modern-gap:{{ section.settings.gap }}px;--promo-height:{{ section.settings.height }}px;--promo-cols:{{ section.settings.columns }};--modern-radius:{{ section.settings.radius }}px"><div class="modern-section__inner"><div class="modern-promos">{% for block in section.blocks %}<article class="modern-promo" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy' }}{% endif %}<div class="modern-promo__content"><h3>{{ block.settings.title }}</h3><div>{{ block.settings.text }}</div>{% if block.settings.label != blank %}<a class="modern-button" href="{{ block.settings.link }}">{{ block.settings.label }}</a>{% endif %}</div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Modern promo banners","max_blocks":3,"settings":[{"type":"range","id":"columns","label":"Desktop columns","min":1,"max":3,"step":1,"default":2},{"type":"range","id":"height","label":"Height","min":280,"max":700,"step":20,"default":420},{"type":"range","id":"gap","label":"Gap","min":8,"max":40,"step":2,"default":20},{"type":"range","id":"radius","label":"Corner radius","min":0,"max":36,"step":2,"default":20},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"default":64}],"blocks":[{"type":"banner","name":"Banner","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Heading","default":"Seasonal collection"},{"type":"richtext","id":"text","label":"Text"},{"type":"text","id":"label","label":"Button label","default":"Shop now"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Modern promo banners","blocks":[{"type":"banner"},{"type":"banner"}]}]}{% endschema %}
