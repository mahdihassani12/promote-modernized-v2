{{ 'modern-sections.css' | asset_url | stylesheet_tag }}
<section class="modern-section" style="--modern-py:{{ section.settings.padding }}px;--quote-bg:{{ section.settings.card_color }};--modern-radius:{{ section.settings.radius }}px"><div class="modern-section__inner"><div class="modern-section__head"><div><h2 class="modern-section__title">{{ section.settings.title }}</h2></div></div><div class="modern-quotes" style="--cols:{{ section.settings.columns }}">{% for block in section.blocks %}<article class="modern-quote" {{ block.shopify_attributes }}><div class="modern-stars">★★★★★</div><div>{{ block.settings.quote }}</div><h3>{{ block.settings.author }}</h3><p>{{ block.settings.role }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Modern testimonials","max_blocks":6,"settings":[{"type":"text","id":"title","label":"Heading","default":"Loved by our customers"},{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":4,"step":1,"default":3},{"type":"color","id":"card_color","label":"Card background","default":"#f6f6f6"},{"type":"range","id":"radius","label":"Corner radius","min":0,"max":36,"step":2,"default":18},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"default":64}],"blocks":[{"type":"quote","name":"Testimonial","settings":[{"type":"richtext","id":"quote","label":"Review","default":"<p>Excellent products and a smooth shopping experience.</p>"},{"type":"text","id":"author","label":"Customer","default":"Customer name"},{"type":"text","id":"role","label":"Subtitle","default":"Verified buyer"}]}],"presets":[{"name":"Modern testimonials","blocks":[{"type":"quote"},{"type":"quote"},{"type":"quote"}]}]}{% endschema %}
