{{ 'modern-sections.css' | asset_url | stylesheet_tag }}
{{ 'modern-carousel.css' | asset_url | stylesheet_tag }}
{{ 'modern-overflow-fix.css' | asset_url | stylesheet_tag }}
<script src="{{ 'modern-carousel.js' | asset_url }}" defer></script>
<section class="modern-section" style="--modern-py:{{ section.settings.padding }}px;--modern-gap:{{ section.settings.gap }}px"><div class="modern-section__inner"><div class="modern-section__head"><div><h2 class="modern-section__title">{{ section.settings.title }}</h2></div></div><div class="modern-carousel" data-modern-carousel><div class="modern-scroll modern-logos-carousel" data-modern-track style="--cols:{{ section.settings.columns }}">{% for block in section.blocks %}<a class="modern-logo" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}{% else %}{{ 'logo' | placeholder_svg_tag }}{% endif %}</a>{% endfor %}</div><div class="modern-carousel__nav"><button class="modern-carousel__button" type="button" data-modern-prev aria-label="Previous brands">&#8592;</button><div class="modern-carousel__dots" data-modern-dots></div><button class="modern-carousel__button" type="button" data-modern-next aria-label="Next brands">&#8594;</button></div></div></div></section>
{% schema %}{"name":"Modern brand logos","max_blocks":18,"settings":[{"type":"text","id":"title","label":"Heading","default":"Brands we love"},{"type":"range","id":"columns","label":"Desktop columns","min":3,"max":8,"step":1,"default":6},{"type":"range","id":"gap","label":"Gap","min":8,"max":40,"step":2,"default":24},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"default":64}],"blocks":[{"type":"logo","name":"Logo","settings":[{"type":"image_picker","id":"image","label":"Logo"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Modern brand logos","blocks":[{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"}]}]}{% endschema %}
