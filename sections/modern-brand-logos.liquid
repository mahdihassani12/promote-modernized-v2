{{ 'modern-sections.css' | asset_url | stylesheet_tag }}
<section class="modern-section" style="--modern-py:{{ section.settings.padding }}px"><div class="modern-section__inner"><div class="modern-section__head"><div><h2 class="modern-section__title">{{ section.settings.title }}</h2></div></div><div class="modern-logos" style="--cols:{{ section.settings.columns }}">{% for block in section.blocks %}<a class="modern-logo" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}{% else %}{{ 'logo' | placeholder_svg_tag }}{% endif %}</a>{% endfor %}</div></div></section>
{% schema %}{"name":"Modern brand logos","max_blocks":18,"settings":[{"type":"text","id":"title","label":"Heading","default":"Brands we love"},{"type":"range","id":"columns","label":"Desktop columns","min":3,"max":8,"step":1,"default":6},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"default":64}],"blocks":[{"type":"logo","name":"Logo","settings":[{"type":"image_picker","id":"image","label":"Logo"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Modern brand logos","blocks":[{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"}]}]}{% endschema %}
