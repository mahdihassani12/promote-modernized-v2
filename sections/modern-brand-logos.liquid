{{ 'modern-sections.css' | asset_url | stylesheet_tag }}
{{ 'modern-carousel.css' | asset_url | stylesheet_tag }}
{{ 'modern-overflow-fix.css' | asset_url | stylesheet_tag }}
<script src="{{ 'modern-carousel.js' | asset_url }}" defer></script>
<style>
  #ModernBrands-{{ section.id }} .modern-scroll { --cols: {{ section.settings.columns }} !important; }
  #ModernBrands-{{ section.id }} .modern-logo img { width: {{ section.settings.logo_width }}px; height: {{ section.settings.logo_height }}px; max-width: 100%; max-height: none; object-fit: contain; }
  @media (max-width: 989px) { #ModernBrands-{{ section.id }} .modern-scroll { --cols: {{ section.settings.columns_tablet }} !important; } }
  @media (max-width: 749px) { #ModernBrands-{{ section.id }} .modern-scroll { --cols: {{ section.settings.columns_mobile }} !important; } }
</style>
<section id="ModernBrands-{{ section.id }}" class="modern-section" style="--modern-py:{{ section.settings.padding }}px;--modern-gap:{{ section.settings.gap }}px"><div class="modern-section__inner"><div class="modern-section__head"><div><h2 class="modern-section__title">{{ section.settings.title }}</h2></div></div><div class="modern-carousel" data-modern-carousel><div class="modern-scroll modern-logos-carousel" data-modern-track>{% for block in section.blocks %}<a class="modern-logo" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}{% else %}{{ 'logo' | placeholder_svg_tag }}{% endif %}</a>{% endfor %}</div><div class="modern-carousel__nav"><button class="modern-carousel__button" type="button" data-modern-prev aria-label="Previous brands">&#8592;</button><div class="modern-carousel__dots" data-modern-dots></div><button class="modern-carousel__button" type="button" data-modern-next aria-label="Next brands">&#8594;</button></div></div></div></section>
{% schema %}{"name":"Modern brand logos","max_blocks":18,"settings":[{"type":"text","id":"title","label":"Heading","default":"Brands we love"},{"type":"range","id":"logo_width","label":"Logo width","min":40,"max":300,"step":10,"unit":"px","default":140},{"type":"range","id":"logo_height","label":"Logo height","min":30,"max":180,"step":10,"unit":"px","default":60},{"type":"range","id":"columns","label":"Logos on desktop","min":2,"max":10,"step":1,"default":6},{"type":"range","id":"columns_tablet","label":"Logos on tablet","min":2,"max":6,"step":1,"default":4},{"type":"range","id":"columns_mobile","label":"Logos on mobile","min":1,"max":4,"step":1,"default":2},{"type":"range","id":"gap","label":"Gap","min":8,"max":40,"step":2,"default":24},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"default":64}],"blocks":[{"type":"logo","name":"Logo","settings":[{"type":"image_picker","id":"image","label":"Logo"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Modern brand logos","blocks":[{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"}]}]}{% endschema %}
