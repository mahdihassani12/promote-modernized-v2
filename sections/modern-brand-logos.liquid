{{ 'modern-brand-logos-glass.css' | asset_url | stylesheet_tag }}
<section id="ModernBrands-{{ section.id }}" class="modern-brands-glass" style="--mbl-padding:{{ section.settings.padding }}px;--mbl-gap:{{ section.settings.gap }}px;--mbl-radius:{{ section.settings.radius }}px;--mbl-speed:{{ section.settings.speed }}s;--mbl-cols:{{ section.settings.columns }};--mbl-cols-tablet:{{ section.settings.columns_tablet }};--mbl-cols-mobile:{{ section.settings.columns_mobile }};--mbl-logo-width:{{ section.settings.logo_width }}px;--mbl-logo-height:{{ section.settings.logo_height }}px;--mbl-heading-size:{{ section.settings.title_size }}px;--mbl-heading-size-mobile:{{ section.settings.title_size_mobile }}px;--mbl-subtitle-size:{{ section.settings.subtitle_size }}px;--mbl-subtitle-size-mobile:{{ section.settings.subtitle_size_mobile }}px;--mbl-heading-align:{{ section.settings.heading_alignment }}">
  <div class="modern-brands-glass__inner">
    {% if section.settings.title != blank or section.settings.subtitle != blank %}<header class="modern-brands-glass__header">{% if section.settings.title != blank %}<h2>{{ section.settings.title }}</h2>{% endif %}{% if section.settings.subtitle != blank %}<div class="modern-brands-glass__subtitle rte">{{ section.settings.subtitle }}</div>{% endif %}</header>{% endif %}
    <div class="modern-brands-glass__viewport{% unless section.settings.autoplay %} modern-brands-glass__viewport--manual{% endunless %}">
      <div class="modern-brands-glass__track">
        {% for duplicate in (1..2) %}<div class="modern-brands-glass__group"{% if duplicate == 2 %} aria-hidden="true"{% endif %}>{% for block in section.blocks %}<a class="modern-brands-glass__card" href="{{ block.settings.link | default: '#' }}"{% if block.settings.link == blank %} aria-disabled="true"{% endif %}{% if duplicate == 1 %} {{ block.shopify_attributes }}{% else %} tabindex="-1"{% endif %}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'eager', widths: '120, 180, 240, 360, 600', alt: block.settings.image.alt }}{% else %}{{ 'logo' | placeholder_svg_tag }}{% endif %}</a>{% endfor %}</div>{% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Modern brand logos","max_blocks":18,"settings":[{"type":"text","id":"title","label":"Section title","default":"Brands we love"},{"type":"richtext","id":"subtitle","label":"Section subtitle","default":"<p>Explore the brands available in our store.</p>"},{"type":"select","id":"heading_alignment","label":"Heading alignment","default":"start","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}]},{"type":"range","id":"title_size","label":"Title size","min":20,"max":72,"step":2,"unit":"px","default":44},{"type":"range","id":"title_size_mobile","label":"Title size on mobile","min":18,"max":48,"step":2,"unit":"px","default":32},{"type":"range","id":"subtitle_size","label":"Subtitle size","min":12,"max":30,"step":1,"unit":"px","default":17},{"type":"range","id":"subtitle_size_mobile","label":"Subtitle size on mobile","min":12,"max":24,"step":1,"unit":"px","default":15},{"type":"checkbox","id":"autoplay","label":"Continuous autoplay","default":true},{"type":"range","id":"speed","label":"Animation duration","min":12,"max":80,"step":2,"unit":"s","default":30},{"type":"range","id":"logo_width","label":"Logo width","min":40,"max":300,"step":10,"unit":"px","default":150},{"type":"range","id":"logo_height","label":"Logo height","min":30,"max":180,"step":10,"unit":"px","default":70},{"type":"range","id":"columns","label":"Logos on desktop","min":2,"max":8,"step":1,"default":5},{"type":"range","id":"columns_tablet","label":"Logos on tablet","min":2,"max":5,"step":1,"default":3},{"type":"range","id":"columns_mobile","label":"Logos on mobile","min":1,"max":3,"step":1,"default":2},{"type":"range","id":"gap","label":"Gap","min":8,"max":40,"step":2,"default":24},{"type":"range","id":"radius","label":"Corner radius","min":8,"max":40,"step":2,"default":28},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"default":64}],"blocks":[{"type":"logo","name":"Logo","settings":[{"type":"image_picker","id":"image","label":"Logo"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Modern brand logos","blocks":[{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"}]}]}
{% endschema %}
