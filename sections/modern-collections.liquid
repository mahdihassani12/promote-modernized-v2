{{ 'modern-sections.css' | asset_url | stylesheet_tag }}
{{ 'modern-carousel.css' | asset_url | stylesheet_tag }}
{{ 'modern-overflow-fix.css' | asset_url | stylesheet_tag }}
<script src="{{ 'modern-carousel.js' | asset_url }}" defer></script>
<section class="modern-section" style="--modern-py:{{ section.settings.padding }}px;--modern-gap:{{ section.settings.gap }}px;--modern-radius:{{ section.settings.radius }}px"><div class="modern-section__inner"><div class="modern-section__head"><div><h2 class="modern-section__title">{{ section.settings.title }}</h2><div class="modern-section__text">{{ section.settings.text }}</div></div></div>{% if section.settings.layout == 'carousel' %}<div class="modern-carousel" data-modern-carousel>{% endif %}<div class="{% if section.settings.layout == 'carousel' %}modern-scroll{% else %}modern-grid{% endif %}"{% if section.settings.layout == 'carousel' %} data-modern-track{% endif %} style="--cols:{{ section.settings.columns }}">{% for collection in section.settings.collections %}<a class="modern-collection" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}{{ 'collection-apparel-1' | placeholder_svg_tag }}{% endif %}<div class="modern-collection__content"><h3>{{ collection.title }}</h3>{% if section.settings.show_count %}<span>{{ collection.products_count }} products</span>{% endif %}</div></a>{% endfor %}</div>{% if section.settings.layout == 'carousel' %}<div class="modern-carousel__nav"><button class="modern-carousel__button" type="button" data-modern-prev aria-label="Previous categories">&#8592;</button><div class="modern-carousel__dots" data-modern-dots></div><button class="modern-carousel__button" type="button" data-modern-next aria-label="Next categories">&#8594;</button></div></div>{% endif %}</div></section>
{% schema %}{"name":"Modern collections","settings":[{"type":"text","id":"title","label":"Heading","default":"Shop by category"},{"type":"richtext","id":"text","label":"Description"},{"type":"collection_list","id":"collections","label":"Collections","limit":12},{"type":"select","id":"layout","label":"Layout","default":"carousel","options":[{"value":"grid","label":"Grid"},{"value":"carousel","label":"Carousel"}]},{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":6,"step":1,"default":4},{"type":"checkbox","id":"show_count","label":"Show product count","default":true},{"type":"range","id":"gap","label":"Gap","min":8,"max":40,"step":2,"default":24},{"type":"range","id":"radius","label":"Corner radius","min":0,"max":36,"step":2,"default":18},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"default":64}],"presets":[{"name":"Modern collections"}]}{% endschema %}
