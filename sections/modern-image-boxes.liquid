{{ 'modern-image-boxes-glass.css' | asset_url | stylesheet_tag }}
<section id="ModernImageBoxes-{{ section.id }}" class="modern-image-boxes-glass" style="--mib-padding:{{ section.settings.padding }}px;--mib-gap:{{ section.settings.gap }}px;--mib-radius:{{ section.settings.radius }}px;--mib-title-size:{{ section.settings.title_size }}px;--mib-heading-size:{{ section.settings.section_title_size }}px;--mib-heading-size-mobile:{{ section.settings.section_title_size_mobile }}px;--mib-subtitle-size:{{ section.settings.subtitle_size }}px;--mib-subtitle-size-mobile:{{ section.settings.subtitle_size_mobile }}px;--mib-heading-align:{{ section.settings.heading_alignment }}">
  <div class="modern-image-boxes-glass__inner">
    {% if section.settings.title != blank or section.settings.subtitle != blank %}<header class="modern-image-boxes-glass__header">{% if section.settings.title != blank %}<h2>{{ section.settings.title }}</h2>{% endif %}{% if section.settings.subtitle != blank %}<div class="modern-image-boxes-glass__subtitle rte">{{ section.settings.subtitle }}</div>{% endif %}</header>{% endif %}
    <div class="modern-image-boxes-glass__grid">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}<a class="modern-image-boxes-glass__card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% else %}<article class="modern-image-boxes-glass__card" {{ block.shopify_attributes }}>{% endif %}
          <div class="modern-image-boxes-glass__content">
            <div class="modern-image-boxes-glass__media">
              {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '96, 144, 192, 240', sizes: '92px', alt: block.settings.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}
            </div>
            {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
            {% if block.settings.description != blank %}<div class="modern-image-boxes-glass__description">{{ block.settings.description }}</div>{% endif %}
          </div>
        {% if block.settings.link != blank %}</a>{% else %}</article>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Modern image boxes","max_blocks":20,"settings":[{"type":"text","id":"title","label":"Section title","default":"Why choose us"},{"type":"richtext","id":"subtitle","label":"Section subtitle","default":"<p>Discover the features that make our products a better choice.</p>"},{"type":"select","id":"heading_alignment","label":"Heading alignment","default":"start","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}]},{"type":"range","id":"section_title_size","label":"Title size","min":20,"max":72,"step":2,"unit":"px","default":44},{"type":"range","id":"section_title_size_mobile","label":"Title size on mobile","min":18,"max":48,"step":2,"unit":"px","default":32},{"type":"range","id":"subtitle_size","label":"Subtitle size","min":12,"max":30,"step":1,"unit":"px","default":17},{"type":"range","id":"subtitle_size_mobile","label":"Subtitle size on mobile","min":12,"max":24,"step":1,"unit":"px","default":15},{"type":"range","id":"title_size","label":"Box title size","min":16,"max":36,"step":1,"unit":"px","default":22},{"type":"range","id":"radius","label":"Corner radius","min":8,"max":40,"step":2,"unit":"px","default":28},{"type":"range","id":"gap","label":"Gap","min":8,"max":40,"step":2,"unit":"px","default":28},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"unit":"px","default":64}],"blocks":[{"type":"image_box","name":"Image box","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Feature title"},{"type":"richtext","id":"description","label":"Description","default":"<p>Add a short description for this feature.</p>"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Modern image boxes","blocks":[{"type":"image_box"},{"type":"image_box"},{"type":"image_box"},{"type":"image_box"}]}]}
{% endschema %}
