{{ 'modern-sections.css' | asset_url | stylesheet_tag }}
{{ 'modern-carousel.css' | asset_url | stylesheet_tag }}
{{ 'modern-overflow-fix.css' | asset_url | stylesheet_tag }}
<script src="{{ 'modern-carousel.js' | asset_url }}" defer></script>

<style>
  #ModernImageBoxes-{{ section.id }} .modern-scroll { --cols: {{ section.settings.columns }} !important; }
  #ModernImageBoxes-{{ section.id }} .modern-image-box {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    color: {{ section.settings.text_color }};
    background: {{ section.settings.card_color }};
    border: 1px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.radius }}px;
    text-align: {{ section.settings.alignment }};
    text-decoration: none;
    {% if section.settings.shadow %}box-shadow: 0 5px 22px rgba(0,0,0,.07);{% endif %}
  }
  #ModernImageBoxes-{{ section.id }} .modern-image-box__media { height: {{ section.settings.image_height }}px; overflow: hidden; background: #f5f5f5; }
  #ModernImageBoxes-{{ section.id }} .modern-image-box__media img,
  #ModernImageBoxes-{{ section.id }} .modern-image-box__media svg { display: block; width: 100%; height: 100%; object-fit: {{ section.settings.image_fit }}; transition: transform .45s ease; }
  #ModernImageBoxes-{{ section.id }} .modern-image-box:hover .modern-image-box__media img { transform: scale(1.035); }
  #ModernImageBoxes-{{ section.id }} .modern-image-box__content { padding: {{ section.settings.content_padding }}px; }
  #ModernImageBoxes-{{ section.id }} .modern-image-box__title { margin: 0 0 10px; font-size: {{ section.settings.title_size }}px; line-height: 1.25; }
  #ModernImageBoxes-{{ section.id }} .modern-image-box__description { margin: 0; opacity: .72; line-height: 1.65; }
  @media (max-width: 989px) {
    #ModernImageBoxes-{{ section.id }} .modern-scroll { --cols: {{ section.settings.columns_tablet }} !important; }
    #ModernImageBoxes-{{ section.id }} .modern-image-box__media { height: {{ section.settings.image_height_tablet }}px; }
  }
  @media (max-width: 749px) {
    #ModernImageBoxes-{{ section.id }} .modern-scroll { --cols: {{ section.settings.columns_mobile }} !important; }
    #ModernImageBoxes-{{ section.id }} .modern-image-box__media { height: {{ section.settings.image_height_mobile }}px; }
  }
</style>

<section id="ModernImageBoxes-{{ section.id }}" class="modern-section" style="--modern-py:{{ section.settings.padding }}px;--modern-gap:{{ section.settings.gap }}px">
  <div class="modern-section__inner">
    <div class="modern-section__head">
      <div>
        <h2 class="modern-section__title">{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}<div class="modern-section__text">{{ section.settings.subtitle }}</div>{% endif %}
      </div>
    </div>

    <div class="modern-carousel" data-modern-carousel>
      <div class="modern-scroll" data-modern-track>
        {% for block in section.blocks %}
          <a class="modern-image-box"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% else %} role="group"{% endif %} {{ block.shopify_attributes }}>
            <div class="modern-image-box__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900, 1200', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 85vw' }}
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="modern-image-box__content">
              {% if block.settings.title != blank %}<h3 class="modern-image-box__title">{{ block.settings.title }}</h3>{% endif %}
              {% if block.settings.description != blank %}<div class="modern-image-box__description">{{ block.settings.description }}</div>{% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
      <div class="modern-carousel__nav">
        <button class="modern-carousel__button" type="button" data-modern-prev aria-label="Previous items">&#8592;</button>
        <div class="modern-carousel__dots" data-modern-dots></div>
        <button class="modern-carousel__button" type="button" data-modern-next aria-label="Next items">&#8594;</button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Modern image boxes",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Why choose us" },
    { "type": "richtext", "id": "subtitle", "label": "Subtitle", "default": "<p>Discover the features that make our products a better choice.</p>" },
    { "type": "range", "id": "columns", "label": "Boxes on desktop", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_tablet", "label": "Boxes on tablet", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Boxes on mobile", "min": 1, "max": 2, "step": 1, "default": 1 },
    { "type": "range", "id": "image_height", "label": "Desktop image height", "min": 120, "max": 500, "step": 10, "unit": "px", "default": 240 },
    { "type": "range", "id": "image_height_tablet", "label": "Tablet image height", "min": 120, "max": 400, "step": 10, "unit": "px", "default": 220 },
    { "type": "range", "id": "image_height_mobile", "label": "Mobile image height", "min": 120, "max": 400, "step": 10, "unit": "px", "default": 200 },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover", "options": [{ "value": "cover", "label": "Cover" }, { "value": "contain", "label": "Contain" }] },
    { "type": "select", "id": "alignment", "label": "Text alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "range", "id": "title_size", "label": "Box title size", "min": 16, "max": 36, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "content_padding", "label": "Content padding", "min": 12, "max": 50, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "checkbox", "id": "shadow", "label": "Show box shadow", "default": true },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#eeeeee" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#222222" },
    { "type": "range", "id": "padding", "label": "Vertical spacing", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "image_box",
      "name": "Image box",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Add a short description for this feature.</p>" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Modern image boxes", "blocks": [{ "type": "image_box" }, { "type": "image_box" }, { "type": "image_box" }] }
  ]
}
{% endschema %}
