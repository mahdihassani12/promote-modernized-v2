{{ 'modern-image-boxes-glass.css' | asset_url | stylesheet_tag }}
<section id="ModernImageBoxes-{{ section.id }}" class="modern-image-boxes-glass" style="--mib-padding:{{ section.settings.padding }}px;--mib-gap:{{ section.settings.gap }}px;--mib-radius:{{ section.settings.radius }}px;--mib-title-size:{{ section.settings.title_size }}px">
  <div class="modern-image-boxes-glass__orb modern-image-boxes-glass__orb--one" aria-hidden="true"></div><div class="modern-image-boxes-glass__orb modern-image-boxes-glass__orb--two" aria-hidden="true"></div>
  <div class="modern-image-boxes-glass__inner">
    <div class="modern-image-boxes-glass__grid">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}<a class="modern-image-boxes-glass__card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% else %}<article class="modern-image-boxes-glass__card" {{ block.shopify_attributes }}>{% endif %}
          <span class="modern-image-boxes-glass__glow" aria-hidden="true"></span>
          <div class="modern-image-boxes-glass__content">
            <div class="modern-image-boxes-glass__media">
              {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '100, 160, 240, 320', sizes: '88px', alt: block.settings.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}
            </div>
            {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
            {% if block.settings.description != blank %}<div class="modern-image-boxes-glass__description">{{ block.settings.description }}</div>{% endif %}
          </div>
        {% if block.settings.link != blank %}</a>{% else %}</article>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Modern image boxes","max_blocks":20,"settings":[{"type":"range","id":"title_size","label":"Box title size","min":16,"max":36,"step":1,"unit":"px","default":22},{"type":"range","id":"radius","label":"Corner radius","min":8,"max":40,"step":2,"unit":"px","default":28},{"type":"range","id":"gap","label":"Gap","min":8,"max":40,"step":2,"unit":"px","default":28},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"unit":"px","default":64}],"blocks":[{"type":"image_box","name":"Image box","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Feature title"},{"type":"richtext","id":"description","label":"Description","default":"<p>Add a short description for this feature.</p>"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Modern image boxes","blocks":[{"type":"image_box"},{"type":"image_box"},{"type":"image_box"},{"type":"image_box"}]}]}
{% endschema %}
