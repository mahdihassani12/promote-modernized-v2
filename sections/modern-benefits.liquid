{{ 'modern-sections.css' | asset_url | stylesheet_tag }}
<section class="modern-section" style="--modern-py:{{ section.settings.padding }}px;--modern-radius:{{ section.settings.radius }}px;--benefit-bg:{{ section.settings.card_color }}"><div class="modern-section__inner"><div class="modern-benefits" style="--cols:{{ section.settings.columns }}">{% for block in section.blocks %}<div class="modern-benefit" {{ block.shopify_attributes }}><div class="modern-benefit__icon">{{ block.settings.icon }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endfor %}</div></div></section>
{% schema %}{"name":"Modern shop benefits","max_blocks":6,"settings":[{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":6,"step":1,"default":4},{"type":"color","id":"card_color","label":"Card background","default":"#ffffff"},{"type":"range","id":"radius","label":"Corner radius","min":0,"max":36,"step":2,"default":16},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"default":48}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"icon","label":"Icon or emoji","default":"✓"},{"type":"text","id":"title","label":"Heading","default":"Secure payments"},{"type":"text","id":"text","label":"Text","default":"Your payment information is protected."}]}],"presets":[{"name":"Modern shop benefits","blocks":[{"type":"benefit","settings":{"icon":"🚚","title":"Fast delivery","text":"Reliable delivery to your door."}},{"type":"benefit","settings":{"icon":"↩","title":"Easy returns","text":"Simple and customer-friendly returns."}},{"type":"benefit"},{"type":"benefit","settings":{"icon":"☏","title":"Customer support","text":"Friendly help when you need it."}}]}]}{% endschema %}
