    { "type": "textarea", "id": "heading_description", "label": "Description" },
    { "type": "select", "id": "heading_alignment", "label": "Desktop text alignment", "options": [{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}], "default": "center" },
    { "type": "select", "id": "heading_alignment_mobile", "label": "Mobile text alignment", "options": [{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}], "default": "center" },
    { "type": "select", "id": "heading_title_font", "label": "Title font", "options": [{"value":"body","label":"Theme body font"},{"value":"heading","label":"Theme heading font"}], "default": "heading" },
    { "type": "select", "id": "heading_description_font", "label": "Description font", "options": [{"value":"body","label":"Theme body font"},{"value":"heading","label":"Theme heading font"}], "default": "body" },
    { "type": "range", "id": "heading_title_size", "label": "Title desktop size", "min": 16, "max": 80, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "heading_title_size_mobile", "label": "Title mobile size", "min": 14, "max": 50, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "heading_title_line", "label": "Title line height", "min": 100, "max": 200, "step": 5, "unit": "%", "default": 120 },
    { "type": "select", "id": "heading_title_weight", "label": "Title weight", "options": [{"value":"400","label":"400"},{"value":"500","label":"500"},{"value":"600","label":"600"},{"value":"700","label":"700"}], "default": "600" },
    { "type": "range", "id": "heading_description_size", "label": "Description desktop size", "min": 12, "max": 36, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "heading_description_size_mobile", "label": "Description mobile size", "min": 12, "max": 30, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "heading_description_line", "label": "Description line height", "min": 100, "max": 220, "step": 5, "unit": "%", "default": 150 },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "range",
      "id": "bg_overlay",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:sections.all.background.overlay",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_item",
      "min": 0,
      "max": 50,
      "step": 0.5,
      "unit": "px",
      "label": "t:sections.all.space_items.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_spacing"
    },
    {
      "type": "text",
      "id": "mg",
      "label": "Margin",
      "info": "Margin top, margin right, margin bottom, margin left. If you not use to blank",
      "default": ",,50px,",
      "placeholder": ",,50px,"
    },
    {
      "type": "text",
      "id": "mg_mb",
      "label": "Margin (Mobile)",
      "default": ",,30px,",
      "placeholder": ",,50px,",
      "visible_if": "{{ section.settings.mg != blank }}"
    },
    {
      "type": "text",
      "id": "pd",
      "label": "Padding",
      "info": "Padding top, padding right, padding bottom, padding left. If you not use to blank",
      "placeholder": "50px,,50px,"
    },
    {
      "type": "text",
      "id": "pd_mb",
      "label": "Padding (Mobile)",
      "placeholder": ",,50px,",
      "visible_if": "{{ section.settings.pd != blank }}"
    },
  ],
  "blocks": [
    {
      "type": "_heading_liquid"
    },
    {
      "type": "_heading_search"
    },
    {
      "type": "_heading_brc"
    }
  ],
