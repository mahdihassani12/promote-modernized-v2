<!-- sections/main-heading.liquid -->
{%- liquid
  if section.settings.use_dynamic_source
    case request.page_type
      when 'collection'
        assign image = collection.featured_image | default: section.settings.image
      when 'article'
        assign image = article.image | default: section.settings.image
    else
      assign image = section.settings.image
    endcase
  else
    assign image = section.settings.image 
  endif
  assign brand_gradient_enabled = false
  if request.page_type == 'page' and section.settings.use_brand_gradient
    assign brand_gradient_enabled = true
  endif
-%}
{% style %}
  {% render 'spacing-vars', box: section %}
  {% if brand_gradient_enabled %}
    #shopify-section-{{ section.id }} .hdt-section-spacing {
      background: linear-gradient({{ section.settings.gradient_angle }}deg, {{ section.settings.gradient_start }} 0%, {{ section.settings.gradient_middle }} 55%, {{ section.settings.gradient_end }} 100%);
      color: {{ section.settings.gradient_text }};
    }
    #shopify-section-{{ section.id }} .hdt-heading-liquid,
    #shopify-section-{{ section.id }} .hdt-heading-liquid a { color: {{ section.settings.gradient_text }}; }
  {% endif %}
  #shopify-section-{{ section.id }} .hdt-brand-heading-content {
    text-align: {{ section.settings.heading_alignment }};
    direction: {% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %};
  }
  #shopify-section-{{ section.id }} .hdt-brand-heading-title {
    margin: 0;
    color: {{ section.settings.gradient_text }};
    font-family: {% if section.settings.heading_title_font == 'body' %}var(--font-body-family){% else %}var(--font-heading-family){% endif %};
    font-size: {{ section.settings.heading_title_size }}px;
    line-height: {{ section.settings.heading_title_line | divided_by: 100.0 }};
    font-weight: {{ section.settings.heading_title_weight }};
  }
  #shopify-section-{{ section.id }} .hdt-brand-heading-description {
    margin: {{ section.settings.space_item }}px 0 0;
    color: {{ section.settings.gradient_text }};
    font-family: {% if section.settings.heading_description_font == 'heading' %}var(--font-heading-family){% else %}var(--font-body-family){% endif %};
    font-size: {{ section.settings.heading_description_size }}px;
    line-height: {{ section.settings.heading_description_line | divided_by: 100.0 }};
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .hdt-brand-heading-content { text-align: {{ section.settings.heading_alignment_mobile }}; }
    #shopify-section-{{ section.id }} .hdt-brand-heading-title { font-size: {{ section.settings.heading_title_size_mobile }}px; }
    #shopify-section-{{ section.id }} .hdt-brand-heading-description { font-size: {{ section.settings.heading_description_size_mobile }}px; }
  }
  #shopify-section-{{ section.id }} .hdt-heading-image{
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  #shopify-section-{{ section.id }} .hdt-heading-image+*{
    position: relative;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .hdt-heading-image:before{
    position: absolute;
    content: "";
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgb(var(--color-overlay));
    opacity: var(--bg-overlay);
  }
  #shopify-section-{{ section.id }} .hdt-row-grid{
    row-gap: {{ section.settings.space_item | divided_by: 2.00 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .hdt-row-grid{
      row-gap: {{ section.settings.space_item }}px;
    }
  }
{% endstyle %}
<div class="hdt-section-spacing hdt-section-spacing-{{ section.id }} hdt-relative hdt-oh" color-scheme="{{ section.settings.color_scheme }}">
  {% unless section.settings.use_translatable_content %}<h1 class="sr-only hdt-pe-none">{{ page_title }}</h1>{% endunless %}
  <div class="hdt-heading-image hdt-h-overlay hdt-pe-none" style="--bg-overlay:{{ section.settings.bg_overlay | divided_by: 100.00 }};">
    {%- if image != blank and brand_gradient_enabled == false -%}
      {{ image | image_url: width: image.width | image_tag: loading: 'lazy', width: image.width, height: image.height, sizes: "100vw", widths: '375,550,750,1100,1500,1780,1920,2000,3000,3840', alt: image.alt, class:'hdt-w-full hdt-h-full hdt-object-cover' }}
    {%- endif -%}
  </div>
  <div class="hdt-container">
    <div class="hdt-row-grid hdt-grid-cols-1 hdt-text-center">
      {% if section.settings.use_translatable_content %}
        <div class="hdt-brand-heading-content">
          <h1 class="hdt-brand-heading-title">{{ section.settings.heading_title | default: page.title | escape }}</h1>
          {% if section.settings.heading_description != blank %}<p class="hdt-brand-heading-description">{{ section.settings.heading_description | escape | newline_to_br }}</p>{% endif %}
        </div>
      {% else %}
        {% content_for 'blocks' %}
      {% endif %}
    </div>
  </div>
</div>
