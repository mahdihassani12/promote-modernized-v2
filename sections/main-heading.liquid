<!-- sections/main-heading.liquid -->
{%- liquid
  capture heading_text
    case request.page_type
      when 'page'
        echo page.title | default: page_title | escape
      when 'collection'
        echo collection.title | escape
      when 'product'
        echo product.title | escape
      when 'article'
        echo article.title | escape
      when 'blog'
        echo blog.title | escape
      when 'customers/login'
        echo 'customer.account.login' | t
      when 'customers/register'
        echo 'customer.account.register' | t
      when 'customers/activate_account'
        echo 'customer.activate_account.title' | t
      when 'customers/reset_password'
        echo 'customer.reset_password.title' | t
      when 'customers/order'
        echo 'customer.order.title' | t: name: order.name
      when 'customers/addresses'
        echo 'customer.addresses.title' | t
      when 'customers/account'
        echo 'customer.account.title' | t
      when 'cart'
        echo 'sections.cart.title' | t
      when 'search'
        if template == 'search.compare'
          echo 'compare_page.title' | t
        elsif template == 'search.wishlist'
          echo 'general.wishlist.wishlist_page' | t
        else
          echo page_title | escape
        endif
      else
        echo page_title | escape
    endcase
  endcapture
-%}
{% style %}
  #shopify-section-{{ section.id }} .hdt-section-spacing {
    background: linear-gradient({{ section.settings.gradient_angle }}deg, {{ section.settings.gradient_start }} 0%, {{ section.settings.gradient_middle }} 55%, {{ section.settings.gradient_end }} 100%);
    color: {{ section.settings.gradient_text }};
    padding: 50px 20px !important;
    margin: 0 !important;
  }
  #shopify-section-{{ section.id }} .hdt-brand-heading-title {
    margin: 0;
    color: {{ section.settings.gradient_text }};
    font-family: var(--font-heading-family);
    font-size: 30px;
    line-height: 1.25;
    font-weight: 600;
    text-align: center;
    text-transform: none;
    direction: {% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %};
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .hdt-section-spacing { padding: 34px 16px !important; }
    #shopify-section-{{ section.id }} .hdt-brand-heading-title { font-size: 30px; }
  }
{% endstyle %}
<div class="hdt-section-spacing hdt-section-spacing-{{ section.id }} hdt-relative hdt-oh">
  <div class="hdt-container">
    <h1 class="hdt-brand-heading-title">{{ heading_text | strip }}</h1>
  </div>
  {%- comment -%}Keep legacy theme blocks registered for existing template compatibility.{%- endcomment -%}
  {%- capture legacy_heading_blocks -%}{% content_for 'blocks' %}{%- endcapture -%}
</div>
{% schema %}
{
  "name": "Page heading",
  "class": "hdt-section hdt-section-heading hdt-main-heading",
  "tag": "section",
  "disabled_on": { "groups": ["*"], "templates": ["index"] },
  "settings": [
    { "type": "header", "content": "Brand gradient" },
    { "type": "color", "id": "gradient_start", "label": "Gradient start", "default": "#3c2d21" },
    { "type": "color", "id": "gradient_middle", "label": "Gradient middle", "default": "#5d432a" },
    { "type": "color", "id": "gradient_end", "label": "Gradient end", "default": "#a73532" },
    { "type": "color", "id": "gradient_text", "label": "Title color", "default": "#ffffff" },
    { "type": "range", "id": "gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 5, "unit": "deg", "default": 120 }
  ],
  "blocks": [
    { "type": "_heading_liquid" },
    { "type": "_heading_search" },
    { "type": "_heading_brc" }
  ]
}
{% endschema %}
