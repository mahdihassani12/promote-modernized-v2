{{ 'professional-hero-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'professional-hero-slider.js' | asset_url }}" defer></script>
{% style %}
  #shopify-section-{{ section.id }} { margin-block-end: {{ section.settings.bottom_spacing }}px; }
  @media (max-width: 767px) { #shopify-section-{{ section.id }} { margin-block-end: {{ section.settings.mobile_bottom_spacing }}px; } }
{% endstyle %}
{%- liquid
  assign slide_count = section.blocks.size
  assign lang = request.locale.iso_code | slice: 0, 2
  assign rtl = false
  if lang == 'ar' or lang == 'fa' or lang == 'ur' or lang == 'he'
    assign rtl = true
  endif
-%}
<div id="ProfessionalHero-{{ section.id }}" class="shop-phs{% if section.settings.zoom %} shop-phs--zoom{% endif %}{% if section.settings.mobile_buttons_full %} shop-phs--mobile-buttons-full{% endif %}" dir="{% if rtl %}rtl{% else %}ltr{% endif %}" role="region" aria-roledescription="carousel" aria-label="{% if rtl %}المحتوى المميز{% else %}Featured content{% endif %}" data-autoplay="{{ section.settings.autoplay }}" data-pause-hover="{{ section.settings.pause_hover }}" data-delay="{{ section.settings.delay | times: 1000 }}" style="
--phs-height:{{ section.settings.height }}px;--phs-mobile-height:{{ section.settings.mobile_height }}px;--phs-transition:{{ section.settings.fade_duration }}ms;
--phs-fallback:{{ section.settings.background }};--phs-overlay:{{ section.settings.overlay_color }};--phs-overlay-opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};
--phs-content-width:{{ section.settings.content_width }}px;--phs-pad-inline:{{ section.settings.padding_side }}px;--phs-pad-block:{{ section.settings.padding_vertical }}px;
--phs-mobile-pad-inline:{{ section.settings.mobile_padding_side }}px;--phs-mobile-pad-block:{{ section.settings.mobile_padding_vertical }}px;
--phs-align:{{ section.settings.alignment }};--phs-mobile-align:{{ section.settings.mobile_alignment }};
--phs-position:{% if section.settings.position == 'center' %}center{% elsif section.settings.position == 'end' %}flex-end{% else %}flex-start{% endif %};
--phs-mobile-position:{% if section.settings.mobile_position == 'center' %}center{% elsif section.settings.mobile_position == 'end' %}flex-end{% else %}flex-start{% endif %};
--phs-gap:{{ section.settings.text_gap }}px;
--phs-eyebrow-color:{{ section.settings.eyebrow_color }};--phs-title-color:{{ section.settings.title_color }};--phs-desc-color:{{ section.settings.description_color }};
--phs-eyebrow-size:{{ section.settings.eyebrow_size }}px;--phs-title-size:{{ section.settings.title_size }}px;--phs-desc-size:{{ section.settings.description_size }}px;
--phs-mobile-eyebrow-size:{{ section.settings.mobile_eyebrow_size }}px;--phs-mobile-title-size:{{ section.settings.mobile_title_size }}px;--phs-mobile-desc-size:{{ section.settings.mobile_description_size }}px;
--phs-eyebrow-weight:{{ section.settings.eyebrow_weight }};--phs-title-weight:{{ section.settings.title_weight }};--phs-desc-weight:{{ section.settings.description_weight }};
--phs-eyebrow-line:{{ section.settings.eyebrow_line | divided_by: 100.0 }};--phs-title-line:{{ section.settings.title_line | divided_by: 100.0 }};--phs-desc-line:{{ section.settings.description_line | divided_by: 100.0 }};
--phs-eyebrow-spacing:{{ section.settings.eyebrow_spacing }}px;--phs-title-spacing:{{ section.settings.title_spacing }}px;--phs-desc-spacing:{{ section.settings.description_spacing }}px;
--phs-eyebrow-align:{{ section.settings.eyebrow_alignment }};--phs-title-align:{{ section.settings.title_alignment }};--phs-desc-align:{{ section.settings.description_alignment }};
--phs-mobile-eyebrow-align:{{ section.settings.mobile_eyebrow_alignment }};--phs-mobile-title-align:{{ section.settings.mobile_title_alignment }};--phs-mobile-desc-align:{{ section.settings.mobile_description_alignment }};
--phs-button-align:{% if section.settings.button_alignment == 'center' %}center{% elsif section.settings.button_alignment == 'end' %}flex-end{% else %}flex-start{% endif %};
--phs-mobile-button-align:{% if section.settings.mobile_button_alignment == 'center' %}center{% elsif section.settings.mobile_button_alignment == 'end' %}flex-end{% else %}flex-start{% endif %};
--phs-eyebrow-font:{% if section.settings.eyebrow_font == 'heading' %}var(--font-heading-family,inherit){% else %}var(--font-body-family,inherit){% endif %};
--phs-title-font:{% if section.settings.title_font == 'heading' %}var(--font-heading-family,inherit){% else %}var(--font-body-family,inherit){% endif %};
--phs-desc-font:{% if section.settings.description_font == 'heading' %}var(--font-heading-family,inherit){% else %}var(--font-body-family,inherit){% endif %};
--phs-button-bg:{{ section.settings.button_background }};--phs-button-text:{{ section.settings.button_text }};--phs-button-hover:{{ section.settings.button_hover }};--phs-button-hover-text:{{ section.settings.button_hover_text }};
--phs-secondary-bg:{{ section.settings.secondary_background }};--phs-secondary-text:{{ section.settings.secondary_text }};--phs-secondary-border:{{ section.settings.secondary_border }};--phs-secondary-hover:{{ section.settings.secondary_hover }};--phs-secondary-hover-text:{{ section.settings.secondary_hover_text }};
--phs-button-size:{{ section.settings.button_size }}px;--phs-mobile-button-size:{{ section.settings.mobile_button_size }}px;--phs-button-weight:{{ section.settings.button_weight }};--phs-button-font:{% if section.settings.button_font == 'heading' %}var(--font-heading-family,inherit){% else %}var(--font-body-family,inherit){% endif %};--phs-button-line:{{ section.settings.button_line | divided_by: 100.0 }};--phs-button-spacing:{{ section.settings.button_spacing }}px;--phs-button-height:{{ section.settings.button_height }}px;--phs-button-radius:{{ section.settings.button_radius }}px;--phs-button-gap:{{ section.settings.button_gap }}px;--phs-button-margin:{{ section.settings.button_margin }}px;
--phs-arrow-color:{{ section.settings.arrow_color }};--phs-arrow-bg:{{ section.settings.arrow_background }};--phs-arrow-border:{{ section.settings.arrow_border }};--phs-arrow-hover:{{ section.settings.arrow_hover }};--phs-arrow-size:{{ section.settings.arrow_size }}px;--phs-arrow-radius:{{ section.settings.arrow_radius }}px;--phs-inset:{{ section.settings.arrow_inset }}px;
--phs-dot-color:{{ section.settings.dot_color }};--phs-dot-active:{{ section.settings.dot_active }};--phs-dot-size:{{ section.settings.dot_size }}px;--phs-dots-gap:{{ section.settings.dot_gap }}px;--phs-dots-bottom:{{ section.settings.dot_bottom }}px;">
  <div class="shop-phs__slides">
    {%- for block in section.blocks -%}
      {%- assign slide = block.settings -%}
      <article class="shop-phs__slide{% if forloop.first %} is-active{% endif %}" data-block-id="{{ block.id }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slide_count }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" {% unless forloop.first %}inert{% endunless %} {{ block.shopify_attributes }} style="{% if slide.custom_overlay %}--phs-overlay:{{ slide.overlay_color }};--phs-overlay-opacity:{{ slide.overlay_opacity | divided_by: 100.0 }};{% endif %}--phs-fit:{{ slide.image_fit }};--phs-image-position:{{ slide.image_position }};--phs-mobile-image-position:{{ slide.mobile_image_position }};">
        {%- assign main_image = slide.image -%}
        {%- if main_image == blank -%}{%- assign main_image = slide.mobile_image -%}{%- endif -%}
        {%- if main_image != blank -%}
          <picture class="shop-phs__media">
            {%- if slide.mobile_image != blank -%}<source media="(max-width: 767px)" srcset="{{ slide.mobile_image | image_url: width: 480 }} 480w, {{ slide.mobile_image | image_url: width: 750 }} 750w, {{ slide.mobile_image | image_url: width: 1000 }} 1000w" sizes="100vw">{%- endif -%}
            {%- if forloop.first -%}
              {{ main_image | image_url: width: 2400 | image_tag: class: 'shop-phs__image', widths: '750,1100,1500,1800,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
            {%- else -%}
              {{ main_image | image_url: width: 2400 | image_tag: class: 'shop-phs__image', widths: '750,1100,1500,1800,2000,2400', sizes: '100vw', loading: 'lazy', alt: '' }}
            {%- endif -%}
          </picture>
        {%- endif -%}
        <span class="shop-phs__overlay" aria-hidden="true"></span>
        <div class="shop-phs__inner"><div class="shop-phs__content">
          {%- if slide.eyebrow != blank -%}<div class="shop-phs__eyebrow">{{ slide.eyebrow | escape }}</div>{%- endif -%}
          {%- if slide.title != blank -%}<{{ section.settings.title_tag }} class="shop-phs__title">{{ slide.title | escape }}</{{ section.settings.title_tag }}>{%- endif -%}
          {%- if slide.description != blank -%}<div class="shop-phs__description">{{ slide.description | escape | newline_to_br }}</div>{%- endif -%}
          {%- if slide.primary_text != blank and slide.primary_link != blank or slide.secondary_text != blank and slide.secondary_link != blank -%}
            <div class="shop-phs__buttons">
              {%- if slide.primary_text != blank and slide.primary_link != blank -%}<a class="shop-phs__button" href="{{ slide.primary_link }}">{{ slide.primary_text | escape }}</a>{%- endif -%}
              {%- if slide.secondary_text != blank and slide.secondary_link != blank -%}<a class="shop-phs__button shop-phs__button--secondary" href="{{ slide.secondary_link }}">{{ slide.secondary_text | escape }}</a>{%- endif -%}
            </div>
          {%- endif -%}
        </div></div>
      </article>
    {%- endfor -%}
  </div>
  {%- if slide_count > 1 -%}
    {%- if section.settings.arrows -%}
      <button type="button" class="shop-phs__arrow shop-phs__arrow--prev" data-action="prev" aria-controls="ProfessionalHero-{{ section.id }}" aria-label="{% if rtl %}الشريحة السابقة{% else %}Previous slide{% endif %}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4l8 8-8 8"/></svg></button>
      <button type="button" class="shop-phs__arrow shop-phs__arrow--next" data-action="next" aria-controls="ProfessionalHero-{{ section.id }}" aria-label="{% if rtl %}الشريحة التالية{% else %}Next slide{% endif %}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4l8 8-8 8"/></svg></button>
    {%- endif -%}
    {%- if section.settings.dots -%}<div class="shop-phs__dots" role="group" aria-label="{% if rtl %}اختر شريحة{% else %}Choose a slide{% endif %}">
      {%- for block in section.blocks -%}<button type="button" class="shop-phs__dot" data-slide="{{ forloop.index0 }}" aria-label="{% if rtl %}انتقل إلى الشريحة{% else %}Go to slide{% endif %} {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}
    </div>{%- endif -%}
  {%- endif -%}
  <span class="shop-phs__status shop-phs__sr" aria-live="polite" aria-atomic="true"></span>
</div>
{% schema %}
{
  "name": "Professional hero slider",
  "tag": "section",
  "class": "professional-hero-section section-allow-transparent",
  "settings": [
