{{ 'professional-hero-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'professional-hero-slider.js' | asset_url }}" defer></script>
{% style %}
  #shopify-section-{{ section.id }} { margin-block-end: 80px; }
  @media (max-width: 767px) { #shopify-section-{{ section.id }} { margin-block-end: 50px; } }
{% endstyle %}
{%- liquid
  assign slide_count = section.blocks.size
  assign lang = request.locale.iso_code | slice: 0, 2
  assign rtl = false
  if lang == 'ar' or lang == 'fa' or lang == 'ur' or lang == 'he'
    assign rtl = true
  endif
-%}
<div id="ProfessionalHero-{{ section.id }}" class="shop-phs shop-phs--mobile-buttons-full" dir="{% if rtl %}rtl{% else %}ltr{% endif %}" role="region" aria-roledescription="carousel" aria-label="{% if rtl %}المحتوى المميز{% else %}Featured content{% endif %}" data-autoplay="{{ section.settings.autoplay }}" data-pause-hover="true" data-delay="{{ section.settings.delay | times: 1000 }}" style="
--phs-height:{{ section.settings.height }}px;--phs-mobile-height:{{ section.settings.mobile_height }}px;
--phs-position:{% if section.settings.position == 'center' %}center{% elsif section.settings.position == 'end' %}flex-end{% else %}flex-start{% endif %};
--phs-mobile-position:{% if section.settings.position == 'center' %}center{% elsif section.settings.position == 'end' %}flex-end{% else %}flex-start{% endif %};
--phs-align:{{ section.settings.alignment }};--phs-mobile-align:{{ section.settings.alignment }};
--phs-title-align:{{ section.settings.alignment }};--phs-eyebrow-align:{{ section.settings.alignment }};--phs-desc-align:{{ section.settings.alignment }};
--phs-mobile-title-align:{{ section.settings.alignment }};--phs-mobile-eyebrow-align:{{ section.settings.alignment }};--phs-mobile-desc-align:{{ section.settings.alignment }};
--phs-button-align:{% if section.settings.alignment == 'center' %}center{% elsif section.settings.alignment == 'end' %}flex-end{% else %}flex-start{% endif %};
--phs-mobile-button-align:{% if section.settings.alignment == 'center' %}center{% elsif section.settings.alignment == 'end' %}flex-end{% else %}flex-start{% endif %};
--phs-title-size:{{ section.settings.title_size }}px;--phs-mobile-title-size:{{ section.settings.mobile_title_size }}px;
--phs-eyebrow-size:{{ section.settings.eyebrow_size }}px;--phs-mobile-eyebrow-size:{{ section.settings.mobile_eyebrow_size }}px;
--phs-desc-size:{{ section.settings.description_size }}px;--phs-mobile-desc-size:{{ section.settings.mobile_description_size }}px;
--phs-button-size:{{ section.settings.button_size }}px;--phs-mobile-button-size:{{ section.settings.mobile_button_size }}px;
--phs-title-font:{% if section.settings.title_font == 'body' %}var(--font-body-family,inherit){% else %}var(--font-heading-family,inherit){% endif %};
--phs-eyebrow-font:{% if section.settings.body_font == 'heading' %}var(--font-heading-family,inherit){% else %}var(--font-body-family,inherit){% endif %};
--phs-desc-font:{% if section.settings.body_font == 'heading' %}var(--font-heading-family,inherit){% else %}var(--font-body-family,inherit){% endif %};
--phs-overlay:#000;--phs-overlay-opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};
--phs-button-bg:{{ section.settings.button_background }};--phs-button-text:#fff;--phs-button-hover:{{ section.settings.button_hover }};--phs-button-hover-text:#fff;
--phs-arrow-hover:{{ section.settings.button_background }};--phs-dot-active:{{ section.settings.button_background }};">
  <div class="shop-phs__slides">
    {%- for block in section.blocks -%}
      {%- assign slide = block.settings -%}
      <article class="shop-phs__slide{% if forloop.first %} is-active{% endif %}" data-block-id="{{ block.id }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slide_count }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" {% unless forloop.first %}inert{% endunless %} {{ block.shopify_attributes }} >
        {%- assign main_image = slide.image -%}
        {%- if main_image == blank -%}{%- assign main_image = slide.mobile_image -%}{%- endif -%}
        {%- if main_image != blank -%}
          <picture class="shop-phs__media">
            {%- if slide.mobile_image != blank -%}<source media="(max-width: 767px)" srcset="{{ slide.mobile_image | image_url: width: 480 }} 480w, {{ slide.mobile_image | image_url: width: 750 }} 750w, {{ slide.mobile_image | image_url: width: 1000 }} 1000w" sizes="100vw">{%- endif -%}
            {%- if forloop.first -%}
              {{ main_image | image_url: width: 2400 | image_tag: class: 'shop-phs__image', widths: '750,1100,1500,1800,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
            {%- else -%}
              {{ main_image | image_url: width: 2400 | image_tag: class: 'shop-phs__image', widths: '750,1100,1500,1800,2000,2400', sizes: '100vw', loading: 'lazy', alt: '' }}
            {%- endif -%}
          </picture>
        {%- endif -%}
        <span class="shop-phs__overlay" aria-hidden="true"></span>
        <div class="shop-phs__inner"><div class="shop-phs__content">
          {%- if slide.title != blank -%}<{{ section.settings.title_tag }} class="shop-phs__title">{{ slide.title | escape }}</{{ section.settings.title_tag }}>{%- endif -%}
          {%- if slide.eyebrow != blank -%}<div class="shop-phs__eyebrow">{{ slide.eyebrow | escape }}</div>{%- endif -%}
          {%- if slide.description != blank -%}<div class="shop-phs__description">{{ slide.description | escape | newline_to_br }}</div>{%- endif -%}
          {%- if slide.primary_text != blank and slide.primary_link != blank or slide.secondary_text != blank and slide.secondary_link != blank -%}
            <div class="shop-phs__buttons">
              {%- if slide.primary_text != blank and slide.primary_link != blank -%}<a class="shop-phs__button" href="{{ slide.primary_link }}">{{ slide.primary_text | escape }}</a>{%- endif -%}
              {%- if slide.secondary_text != blank and slide.secondary_link != blank -%}<a class="shop-phs__button shop-phs__button--secondary" href="{{ slide.secondary_link }}">{{ slide.secondary_text | escape }}</a>{%- endif -%}
            </div>
          {%- endif -%}
        </div></div>
      </article>
    {%- endfor -%}
  </div>
  {%- if slide_count > 1 -%}
    {%- if section.settings.arrows -%}
      <button type="button" class="shop-phs__arrow shop-phs__arrow--prev" data-action="prev" aria-controls="ProfessionalHero-{{ section.id }}" aria-label="{% if rtl %}الشريحة السابقة{% else %}Previous slide{% endif %}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4l8 8-8 8"/></svg></button>
      <button type="button" class="shop-phs__arrow shop-phs__arrow--next" data-action="next" aria-controls="ProfessionalHero-{{ section.id }}" aria-label="{% if rtl %}الشريحة التالية{% else %}Next slide{% endif %}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4l8 8-8 8"/></svg></button>
    {%- endif -%}
    {%- if section.settings.dots -%}<div class="shop-phs__dots" role="group" aria-label="{% if rtl %}اختر شريحة{% else %}Choose a slide{% endif %}">
      {%- for block in section.blocks -%}<button type="button" class="shop-phs__dot" data-slide="{{ forloop.index0 }}" aria-label="{% if rtl %}انتقل إلى الشريحة{% else %}Go to slide{% endif %} {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}
    </div>{%- endif -%}
  {%- endif -%}
  <span class="shop-phs__status shop-phs__sr" aria-live="polite" aria-atomic="true"></span>
</div>
{% schema %}
{
  "name": "Professional hero slider",
  "tag": "section",
  "class": "professional-hero-section section-allow-transparent",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "default": 700,
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile minimum height",
      "default": 560,
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Content position",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text and button alignment",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "Title heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay strength",
      "default": 50,
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Text sizes"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Title font",
      "default": "heading",
      "options": [
        {
          "value": "heading",
          "label": "Theme heading font"
        },
        {
          "value": "body",
          "label": "Theme body font"
        }
      ]
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title desktop size",
      "default": 72,
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Title mobile size",
      "default": 34,
      "min": 18,
      "max": 60,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Subtitle and description font",
      "default": "body",
      "options": [
        {
          "value": "heading",
          "label": "Theme heading font"
        },
        {
          "value": "body",
          "label": "Theme body font"
        }
      ]
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Subtitle desktop size",
      "default": 18,
      "min": 12,
      "max": 50,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_size",
      "label": "Subtitle mobile size",
      "default": 16,
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description desktop size",
      "default": 20,
      "min": 12,
      "max": 50,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "label": "Description mobile size",
      "default": 16,
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button desktop text size",
      "default": 15,
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_button_size",
      "label": "Button mobile text size",
      "default": 14,
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#5d432a"
    },
    {
      "type": "color",
      "id": "button_hover",
      "label": "Button hover background",
      "default": "#a73532"
    },
    {
      "type": "header",
      "content": "Slide controls"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Autoplay delay",
      "default": 7,
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Show pagination",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Subtitle"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "primary_text",
          "label": "Primary button text"
        },
        {
          "type": "url",
          "id": "primary_link",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "secondary_text",
          "label": "Secondary button text"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Secondary button link"
        },
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image (optional)"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Professional hero slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
