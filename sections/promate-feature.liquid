{%- liquid
  assign feature_title = section.settings.title
  if feature_title == blank
    assign feature_title = 'barberry.promate.title' | t
  endif
  assign feature_text = section.settings.text
  if feature_text == blank
    assign feature_text = 'barberry.promate.description' | t
  endif
  assign feature_button = section.settings.button_label
  if feature_button == blank
    assign feature_button = 'barberry.promate.button' | t
  endif
-%}

<section class="bb-promate" aria-labelledby="bb-promate-title-{{ section.id }}">
  <div class="bb-promate__inner">
    <h2 id="bb-promate-title-{{ section.id }}">{{ feature_title | escape }}</h2>
    <p>{{ feature_text | escape }}</p>
    <a class="bb-promate__button" href="{{ section.settings.link | default: 'https://promate.iq/' }}" target="_blank" rel="noopener noreferrer">
      {{ feature_button | escape }}
      <span aria-hidden="true">{% if request.locale.iso_code == 'ar' %}←{% else %}→{% endif %}</span>
    </a>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .bb-promate {
    padding: 64px 20px;
    background: linear-gradient(120deg, #f8f5f1 0%, #f3ebe7 100%);
    color: #3c2d21;
    text-align: center;
    direction: {% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %};
  }
  #shopify-section-{{ section.id }} .bb-promate__inner {
    max-width: 760px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .bb-promate h2 {
    margin: 0 0 16px;
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.2;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .bb-promate p {
    margin: 0 auto 26px;
    font-size: 17px;
    line-height: 1.7;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .bb-promate__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 46px;
    padding: 10px 24px;
    border-radius: 8px;
    background: #a73532;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: background-color .2s ease;
  }
  #shopify-section-{{ section.id }} .bb-promate__button:hover,
  #shopify-section-{{ section.id }} .bb-promate__button:focus-visible { background: #752824; color: #fff; }
  #shopify-section-{{ section.id }} .bb-promate__button:focus-visible { outline: 2px solid #3c2d21; outline-offset: 3px; }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .bb-promate { padding: 48px 18px; }
    #shopify-section-{{ section.id }} .bb-promate p { font-size: 15px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Promate Iraq feature",
  "settings": [
    { "type": "paragraph", "content": "Leave text fields blank to use the built-in English and Arabic translations." },
    { "type": "text", "id": "title", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Short text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "link", "label": "Button link", "default": "https://promate.iq/" }
  ],
  "presets": [{ "name": "Promate Iraq feature" }]
}
{% endschema %}
