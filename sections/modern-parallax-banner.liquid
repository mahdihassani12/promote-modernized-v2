{{ 'modern-sections.css' | asset_url | stylesheet_tag }}
<style>
  #ModernParallax-{{ section.id }} { min-height: {{ section.settings.height }}px; }
  @media (max-width: 989px) { #ModernParallax-{{ section.id }} { min-height: {{ section.settings.height_tablet }}px; } }
  @media (max-width: 749px) { #ModernParallax-{{ section.id }} { min-height: {{ section.settings.height_mobile }}px; } }
</style>
<section id="ModernParallax-{{ section.id }}" class="modern-parallax" style="{% if section.settings.image %}background-image:url('{{ section.settings.image | image_url: width: 2400 }}');{% endif %}--overlay:{{ section.settings.overlay | divided_by: 100.0 }};--parallax-color:{{ section.settings.color }}"><div class="modern-parallax__content"><h2>{{ section.settings.title }}</h2><div>{{ section.settings.text }}</div>{% if section.settings.label != blank %}<a class="modern-button" href="{{ section.settings.link }}">{{ section.settings.label }}</a>{% endif %}</div></section>
{% schema %}{"name":"Modern parallax banner","settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"range","id":"height","label":"Desktop height","min":320,"max":900,"step":20,"default":580},{"type":"range","id":"height_tablet","label":"Tablet height","min":260,"max":700,"step":20,"default":460},{"type":"range","id":"height_mobile","label":"Mobile height","min":220,"max":600,"step":20,"default":360},{"type":"range","id":"overlay","label":"Overlay opacity","min":0,"max":80,"step":5,"default":35},{"type":"color","id":"color","label":"Text color","default":"#ffffff"},{"type":"text","id":"title","label":"Heading","default":"Make a lasting impression"},{"type":"richtext","id":"text","label":"Text"},{"type":"text","id":"label","label":"Button label","default":"Explore now"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"Modern parallax banner"}]}{% endschema %}
