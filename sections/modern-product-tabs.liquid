{{ 'modern-sections.css' | asset_url | stylesheet_tag }}
<section id="ModernTabs-{{ section.id }}" class="modern-section" style="--modern-py:{{ section.settings.padding }}px;--modern-gap:{{ section.settings.gap }}px">
  <div class="modern-section__inner">
    <div class="modern-section__head"><div><h2 class="modern-section__title">{{ section.settings.title }}</h2><div class="modern-section__text">{{ section.settings.text }}</div></div></div>
    <div class="modern-tabs" role="tablist">{% for block in section.blocks %}<button type="button" class="modern-tab{% if forloop.first %} is-active{% endif %}" data-modern-tab="{{ block.id }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</button>{% endfor %}</div>
    {% for block in section.blocks %}<div class="modern-tab-panel{% unless forloop.first %} is-hidden{% endunless %}" data-modern-panel="{{ block.id }}"><div class="hdt-collection-products hdt-ratio--{{ section.settings.image_ratio }} hdt-ratio--contain {% if section.settings.layout == 'carousel' %}modern-scroll{% else %}modern-grid{% endif %}" style="--cols:{{ section.settings.columns }}">{% for product in block.settings.collection.products limit: section.settings.limit %}{% render 'card-product1', card_product: product, class: 'hdt-pr-style1', section_id: section.id, sizes: '(min-width: 990px) 25vw, 50vw', image_ratio: section.settings.image_ratio, show_vendor: section.settings.show_vendor %}{% endfor %}</div></div>{% endfor %}
  </div>
</section>
<style>#ModernTabs-{{ section.id }} .modern-tabs{display:flex;gap:10px;overflow:auto;margin:0 0 28px;padding-bottom:4px}#ModernTabs-{{ section.id }} .modern-tab{white-space:nowrap;border:1px solid rgba(0,0,0,.13);background:transparent;border-radius:999px;padding:10px 18px;cursor:pointer}#ModernTabs-{{ section.id }} .modern-tab.is-active{background:#111;color:#fff;border-color:#111}#ModernTabs-{{ section.id }} .is-hidden{display:none}</style>
<script>document.addEventListener('DOMContentLoaded',()=>{const s=document.querySelector('#ModernTabs-{{ section.id }}');if(!s)return;s.querySelectorAll('[data-modern-tab]').forEach(b=>b.addEventListener('click',()=>{s.querySelectorAll('[data-modern-tab]').forEach(x=>{x.classList.remove('is-active');x.setAttribute('aria-selected','false')});s.querySelectorAll('[data-modern-panel]').forEach(x=>x.classList.add('is-hidden'));b.classList.add('is-active');b.setAttribute('aria-selected','true');s.querySelector('[data-modern-panel="'+b.dataset.modernTab+'"]').classList.remove('is-hidden')}))});</script>
{% schema %}{"name":"Modern product tabs","max_blocks":5,"settings":[{"type":"text","id":"title","label":"Heading","default":"Shop our favorites"},{"type":"richtext","id":"text","label":"Description"},{"type":"select","id":"layout","label":"Products layout","default":"carousel","options":[{"value":"grid","label":"Grid"},{"value":"carousel","label":"Carousel"}]},{"type":"range","id":"limit","label":"Products per tab","min":2,"max":12,"step":1,"default":8},{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":6,"step":1,"default":4},{"type":"range","id":"gap","label":"Gap","min":8,"max":40,"step":2,"default":24},{"type":"select","id":"image_ratio","label":"Image ratio","default":"adapt_image","options":[{"value":"adapt_image","label":"Adapt"},{"value":"square","label":"Square"}]},{"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false},{"type":"range","id":"padding","label":"Vertical spacing","min":20,"max":120,"step":4,"default":64}],"blocks":[{"type":"tab","name":"Collection tab","settings":[{"type":"text","id":"label","label":"Tab label"},{"type":"collection","id":"collection","label":"Collection"}]}],"presets":[{"name":"Modern product tabs","blocks":[{"type":"tab","settings":{"label":"New arrivals"}},{"type":"tab","settings":{"label":"Best sellers"}},{"type":"tab","settings":{"label":"On sale"}}]}]}{% endschema %}
